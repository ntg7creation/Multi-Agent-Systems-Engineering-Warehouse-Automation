{
  "scenario_id": "default",
  "name": "Default Two-Agent Warehouse",
  "description": "Small baseline scenario with two agents and two pickup-and-delivery tasks.",
  "grid": {
    "width": 12,
    "height": 8,
    "blocked": [[3, 1], [3, 2], [3, 3], [3, 5], [3, 6], [7, 1], [7, 2], [7, 4], [7, 5], [7, 6]]
  },
  "pickups": {
    "pickup_a": [1, 1],
    "pickup_b": [1, 6]
  },
  "dropoffs": {
    "dropoff_a": [10, 1],
    "dropoff_b": [10, 6]
  },
  "agents": [
    {"agent_id": "agent_1", "position": [5, 1]},
    {"agent_id": "agent_2", "position": [5, 6]}
  ],
  "items": [
    {"item_id": "box_1", "task_id": "delivery_1", "pickup_id": "pickup_a", "dropoff_id": "dropoff_a"},
    {"item_id": "box_2", "task_id": "delivery_2", "pickup_id": "pickup_b", "dropoff_id": "dropoff_b"}
  ],
  "tasks": [
    {"task_id": "delivery_1", "pickup_id": "pickup_a", "dropoff_id": "dropoff_a", "item_id": "box_1"},
    {"task_id": "delivery_2", "pickup_id": "pickup_b", "dropoff_id": "dropoff_b", "item_id": "box_2"}
  ],
  "default_seed": 42,
  "config": {
    "perception_radius": 3,
    "allocation_strategy": "nearest_available",
    "routing_strategy": "local_memory_astar",
    "path_weights": {
      "alpha_distance": 1.0,
      "beta_congestion": 2.0,
      "gamma_failed_route": 1.5,
      "delta_uncertainty": 0.3,
      "near_optimal_margin": 0.35
    }
  }
}
